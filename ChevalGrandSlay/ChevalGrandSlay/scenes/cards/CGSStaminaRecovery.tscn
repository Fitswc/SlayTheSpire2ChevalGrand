[gd_scene load_steps=3 format=3]

[sub_resource type="Shader" id="Shader_recovery"]
code = "shader_type canvas_item;
render_mode unshaded;

uniform vec4 tint : source_color = vec4(0.51, 0.79, 1.0, 0.20);

void fragment() {
	// Match the lock overlay's card frame, energy icon, and title banner.
	vec2 point = UV * vec2(334.0, 440.0) - vec2(167.0, 228.0);
	vec2 corner = abs(point) - vec2(126.0, 187.0);
	float frame = length(max(corner, vec2(0.0))) + min(max(corner.x, corner.y), 0.0) - 24.0;
	float energy = length(point - vec2(-134.0, -195.0)) - 31.0;
	float banner_width = mix(149.0, 162.0, smoothstep(-149.0, -125.0, point.y));
	float banner = max(abs(point.x - 0.5) - banner_width, max(-149.0 - point.y, point.y + 125.0));
	float shape = min(frame, min(energy, banner));
	float coverage = 1.0 - smoothstep(-max(fwidth(shape), 0.01), 0.0, shape);
	COLOR = vec4(tint.rgb, tint.a * coverage);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_recovery"]
shader = SubResource("Shader_recovery")

